# Пути считаются от корня проекта. Реальные записи и веса не хранятся в Git.
AUTOPROTOCOL_DATA_DIR=data
AUTOPROTOCOL_MODELS_DIR=models
AUTOPROTOCOL_DEVICE=cpu
# Web-конвейер ограничен 10 минутами до проверки длинных записей.
AUTOPROTOCOL_MAX_UPLOAD_MB=250
AUTOPROTOCOL_MAX_DURATION_MINUTES=10
AUTOPROTOCOL_STAGE_TIMEOUT_SECONDS=1800
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
PYANNOTE_METRICS_ENABLED=0
